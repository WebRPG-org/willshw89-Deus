# Whitelist: the project root is also the Dwarf Fortress install and holds the U7 installs.
# Ignore everything at the root, then allow only our own files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/docs/
!/game/
!/tools/
!/art/
!/archive/
!/.agents/
!/tasks/
!/prompts/
!/baseline/
!/launch_demo.bat
!/open_in_rmmz.bat
!/run_autotest.bat
!/run_tests.bat
!/Deus.exe

# Generated by test runs
/game/game_runtime.log
/game/game_error.log
/game/test_screenshot.png
/game/test_output/
/game/save/
/art/review/

# Art staging, sprites scratch, and tileset scratch
/art/staging/
/art/sprites/
/art/tilesets/

# Temporary test harnesses and experimental UI assets
/game/img/system/ui_open_sack*.png
/tools/capture_sack_ui_playtest.js
/tools/test_sack_ui_and_loose_items.js
/tools/test_shadow_check_wg0041.js

# Temporary task execution outputs and local prompts
/tasks/*.txt



